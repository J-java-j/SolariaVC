# Website build settings. Only the flag and Firebase web API key belong in Vite.
VITE_TEAM_PORTAL_ENABLED=false
VITE_TEAM_FIREBASE_API_KEY=
VITE_TEAM_FIREBASE_TENANT=

# Staff API and operator environment. Inject secrets using the staging secret store.
TEAM_AUTH_MODE=staging
TEAM_FIREBASE_PROJECT=
TEAM_FIREBASE_TENANT=
TEAM_SESSION_DATABASE=
TEAM_TERMINAL_ORIGIN=
TEAM_VERIFIER_ORIGIN=
TEAM_TERMINAL_CALLER=
TEAM_PORTAL_ORIGIN=
TEAM_INVITE_EMAILS=
TEAM_MAIL_FROM=
TEAM_RESEND_API_KEY=

# Operator command only
TEAM_OWNER_EMAIL=
