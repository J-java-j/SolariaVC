# Copy values into the appropriate build or runtime configuration.
# Keep mail credentials in the deployment secret store.
# Website Docker build arguments
VITE_TEAM_PORTAL_ENABLED=true
VITE_TEAM_FIREBASE_TENANT=team-login-prod-drkt6
VITE_TEAM_FIREBASE_API_KEY=

# Website runtime
TEAM_AUTH_MODE=production
TEAM_FIREBASE_PROJECT=gen-lang-client-0188652481
TEAM_FIREBASE_TENANT=team-login-prod-drkt6
TEAM_SESSION_DATABASE=team-login-prod
TEAM_PORTAL_ORIGIN=https://solariavc.com
TEAM_TERMINAL_ORIGIN=https://terminal.solariavc.com
TEAM_TERMINAL_HANDOFF=on
TEAM_INVITE_EMAILS=
TEAM_MAIL_FROM=
TEAM_RESEND_API_KEY=

# Verifier runtime (also uses the project, tenant and database above)
