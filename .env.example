# Required for contact form email delivery (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Optional (recipient is hardcoded to contact@solariavc.com in server/index.js)
CONTACT_FROM_EMAIL=Solaria Capital <onboarding@resend.dev>

# Solaria Sign (all optional locally; without RESEND_API_KEY messages are written
# to .sign-data/outbox so links can be followed in development)
# SIGN_FROM_EMAIL=Solaria Capital <sign@solariavc.com>
# SIGN_BASE_URL=http://localhost:5173
# SIGN_STORE=local
