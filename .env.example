# Production secrets belong in the deployment secret manager, never source control.
RESEND_API_KEY=
# Must use a Resend-verified domain; onboarding@resend.dev cannot email visitors.
CONTACT_FROM_EMAIL=Solaria <hello@solariavc.com>

# Public widget key + server-only secret; action is "contact".
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_ALLOWED_ORIGINS=https://solariavc.com,https://www.solariavc.com

# Shared durable quotas + encrypted pending verifications across all instances.
# Firestore uses Cloud Run's existing service identity; do not create JSON keys.
CONTACT_STORE=firestore
# Optional override; otherwise the SDK discovers the Google Cloud project.
CONTACT_FIRESTORE_PROJECT_ID=
CONTACT_FIRESTORE_DATABASE_ID=(default)
CONTACT_FIRESTORE_COLLECTION=solaria_contact
# Optional legacy alternative, used only with CONTACT_STORE=redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Supply a securely generated value with at least 32 bytes of entropy.
CONTACT_VERIFICATION_SECRET=
# Total unique contact emails per UTC day, including codes and team deliveries.
# Both are reserved together; provider-idempotent retries reuse the reservation.
# Default 80 leaves headroom below a common 100/day tier; verify your actual plan.
CONTACT_EMAIL_DAILY_LIMIT=80

# Default ignores X-Forwarded-For. Configure only after verifying every ingress.
CONTACT_TRUST_PROXY_HOPS=0

# Explicit localhost-only development adapter; disabled in production/Cloud Run.
CONTACT_LOCAL_DEV=false
